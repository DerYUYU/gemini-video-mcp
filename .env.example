# Google Gemini API key from AI Studio. Never commit this file.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional, timeout for the analysis request in milliseconds. Defaults to 600000 (10 minutes).
GEMINI_TIMEOUT_MS=600000

# Instagram only. YouTube works without any of these.
# Full path to the yt-dlp executable. Defaults to "yt-dlp" from PATH.
YTDLP_PATH=
# Optional, timeout for the download in milliseconds. Defaults to 300000 (5 minutes).
YTDLP_TIMEOUT_MS=300000
# Optional, how long to wait for Gemini to process the upload. Defaults to 300000.
UPLOAD_TIMEOUT_MS=300000
# Optional, size ceiling for a downloaded video in MB. Defaults to 250.
MAX_VIDEO_MB=250
